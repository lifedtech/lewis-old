# ==============================================================================
# LEWIS Core Engine Environment Variables
# ==============================================================================

# Deployment environment. Controls fail-fast behavior for production secret
# checks (SEC-005) and whether API docs are exposed (SEC-009). Set this
# explicitly to "production" wherever this actually runs in production —
# it is NOT auto-detected from any platform-specific variable, since this
# app can deploy to Railway, Render, or anywhere else.
ENVIRONMENT=development

# Optional NVIDIA-hosted LLM API key (for optional Road B narrative
# voicing via LEWIS_ENABLE_LLM=true). Narrative generation always falls
# back to the deterministic Road A text if unset — not required to run.
NVIDIA_API_KEY=your-nvidia-api-key
LEWIS_ENABLE_LLM=false

# Frontend URL(s) for CORS configuration (comma-separated for multiple).
FRONTEND_URL=http://localhost:5173

# Redis connection for the outbound mail queue (mail_queue.py). Provision a
# Redis instance in production (e.g. Railway's Redis plugin, Upstash) and set
# this to its connection URL. If unset/unreachable, mail still sends — it just
# falls back to a direct-send thread with no retry/persistence across restarts,
# same as before this queue existed.
#
# Railway's Redis plugin: reference its REDIS_URL variable on the WEB service
# too (Variables tab -> add REDIS_URL -> ${{Redis.REDIS_URL}}), or mail_queue.py
# also falls back to Railway's split REDISHOST/REDISPORT/REDISUSER/REDISPASSWORD
# vars if only those are present.
REDIS_URL=redis://localhost:6379/0

# Trusted reverse-proxy IPs/CIDRs for rate-limiting by real client IP
# (SEC-004). Leave unset in local dev. In production, this MUST be the
# actual edge/proxy IP range of your Railway/Render deployment, never "*" —
# determine it by observing what request.client.host resolves to once
# deployed (e.g. temporarily log it, or watch the 429 rate-limit log line).
# Unset defaults to 127.0.0.1, which means X-Forwarded-For is not trusted
# and every request is rate-limited by the raw TCP peer instead (safe, but
# may bucket all users together behind a platform proxy until this is set).
LEWIS_TRUSTED_PROXY_IPS=127.0.0.1

# ------------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (ENVIRONMENT=production) — the app refuses to start
# without these; see auth.py. Not required in development, where safe
# ephemeral/local fallbacks are used automatically instead.
# ------------------------------------------------------------------------------

# Anonymization HMAC salt. Must be a long, random, stable secret — rotating
# it changes every anonymous-code mapping. Generate with e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`.
LEWIS_ANON_SALT=

# Supabase Cloud Database Integration (LifedHealth User Portal Shared DB).
# Fill these in from your Supabase project settings (https://app.supabase.com).
# SUPABASE_SERVICE_KEY is a service-role-class key — NEVER expose it to the
# frontend/browser or prefix it with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Internal-only shared key for GET /analytics/onboarding (SEC-010). Not a
# user credential — meant for a trusted internal caller (e.g. the
# Onboarding system), sent as the X-Internal-Key header. Required in
# production; the endpoint is disabled if unset.
LEWIS_ANALYTICS_API_KEY=

# ------------------------------------------------------------------------------
# Razorpay Payment Integration & Entitlements
# ------------------------------------------------------------------------------
# Mode: "mock" (for simulated local checkout) | "razorpay" (uses live/test keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price in paise (74900 = ₹749)
PERSONAL_REPORT_PRICE_PAISE=74900
TRANSFORMATION_BUNDLE_PRICE_PAISE=149900

# ------------------------------------------------------------------------------
# Optional overrides (sane defaults apply if unset)
# ------------------------------------------------------------------------------
# LEWIS_REQUIRE_SECRET_CONFIG=true   # force the production secret checks even outside ENVIRONMENT=production
# LEWIS_SESSION_TTL_SECONDS=604800   # 7 days
# LEWIS_MAX_BODY_BYTES=262144        # 256 KB request body cap
# LEWIS_RATE_LIMIT=60                # default requests/min/IP
# LEWIS_RATE_LIMIT_HEAVY=12          # /assessment/full, /pulse/calculate
# LEWIS_RATE_LIMIT_AUTH=5            # /auth/login, /auth/register
