{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lewis-old",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "lewiswellbeing.com", "custom_domain": true },
    { "pattern": "www.lewiswellbeing.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*", "/support/*"]
  }
}
